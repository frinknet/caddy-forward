{
	admin off
	http_port 2080
	https_port 0
}

# ── Backends: what the forward directive or template functions proxy to ─────
:2081 {
	bind 127.0.0.1
	respond "backend-ok" 200
}

:2082 {
	bind 127.0.0.1
	header Content-Type text/plain
	respond `{http.request.method} {http.request.uri}`
}

:2083 {
	bind 127.0.0.1
	respond `{http.request.body}`
}

# ── Test routes ────────────────────────────────────────────────────────────
:2080 {
	bind 127.0.0.1

	# 1. forward GET
	route /t-forward {
		forward GET "http://127.0.0.1:2081/"
	}

	# 2. forward with params
	route /t-forward-params {
		forward GET "http://127.0.0.1:2081/" {
			param q "caddy"
		}
	}

	# 3. forward with headers
	route /t-forward-headers {
		forward GET "http://127.0.0.1:2081/" {
			header Authorization "Bearer test"
		}
	}

	# 4. forward POST with body
	route /t-forward-post {
		forward POST "http://127.0.0.1:2083/" {
			body "hello body"
		}
	}

	# 5–10: template rendering (file_server + templates processes .html files)
	handle_path /t/* {
		root * /srv/www/test/tmpl
		templates {
			extensions {
				forward_methods
			}
		}
		file_server
	}

	# 11. forward USE (serve exactly that template, with query and body)
	route /t-use {
		root * /srv/www/test/tmpl
		forward USE use-page.html {
			param q caddy
			body  "hello body"
		}
	}
}